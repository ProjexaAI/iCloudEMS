# Copy this file to server/.env for local development.
# Use your deployment platform's secret manager in production.

ENVIRONMENT=development
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# PostgreSQL mirror and encrypted provider-token storage.
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/icloudems

# Redis runtime state: rate limits, locks, idempotency, and job coordination.
REDIS_URL=redis://127.0.0.1:6379/0

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=replace-with-a-fernet-key

# Cache freshness.
ROSTER_CACHE_TTL_SECONDS=86400
ROSTER_CACHE_TTL_TODAY_SECONDS=900
ROSTER_CACHE_TTL_RECENT_SECONDS=3600

# Provider circuit breaker.
PROVIDER_FAILURE_THRESHOLD=5
PROVIDER_COOLDOWN_SECONDS=60

# Runtime limits.
ROSTER_FETCH_CONCURRENCY=20
MAX_JOBS_PER_SESSION=2
MAX_REQUESTS_PER_MINUTE=120
CACHE_RETENTION_DAYS=730

# Keep false in production.
DEBUG_MODE=false